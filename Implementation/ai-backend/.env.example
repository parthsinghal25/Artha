# Copy to .env (git-ignored). Never put real secrets in source, docs or logs.
# --- Gemini Developer API (Free tier only) ---------------------------------
# Server-side key from a project whose AI Studio tier is "Free" and has NO billing enabled.
GEMINI_API_KEY=
# Set to 1 only after verifying in AI Studio that the key's project is Free tier with billing disabled.
SDB_GEMINI_FREE_TIER_ATTESTED=0
SDB_GEMINI_MODEL=gemini-3.8-flash
# Copy the project's actual limits from https://aistudio.google.com/rate-limit (local pacing; provider stays authoritative)
SDB_GEMINI_RPM=5
SDB_GEMINI_TPM=200000
SDB_GEMINI_RPD=100
# --- Model routing / fallback ------------------------------------------------
# auto = Gemini if usable, else local Gemma; fallback to Gemma on sustained quota (new run/analysis version)
SDB_MODEL_PROVIDER=auto
SDB_MODEL_CONCURRENCY=1
SDB_FALLBACK_QUOTA_FAILURES=3
SDB_FALLBACK_MAX_ETA_SECONDS=21600
SDB_GEMMA_MODEL_PATH=var/models/gemma-4-e4b-it-4bit
SDB_GEMMA_MODEL_ID=mlx-community/gemma-4-e4b-it-4bit
# --- Storage / serving --------------------------------------------------------
SDB_DATA_DIR=var/data
SDB_HOST=127.0.0.1
SDB_PORT=8080
SDB_UI_ORIGIN=http://127.0.0.1:5173
# Comma-separated extra browser origins allowed to call the API directly (normally empty: same-origin via UI gateway)
SDB_ALLOWED_ORIGINS=
# Serve a release whose sources still await independent review (labelled in every inventory). Dev integration only.
SDB_ALLOW_UNREVIEWED_SOURCES=0
SDB_SESSION_TTL_SECONDS=28800
SDB_CONTEXT_TTL_SECONDS=300
SDB_ASSET_TOKEN_TTL_SECONDS=300
SDB_COOKIE_SECURE=0
