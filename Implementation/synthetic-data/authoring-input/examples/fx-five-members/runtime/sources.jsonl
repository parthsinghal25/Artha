{"source_id": "FX-SRC-0404", "kind": "email", "semantic_type": "external_scheme_notice", "source_family": "S12", "format": "EML", "filename": "2026-08-20_1645_scheme_fee-invoice.eml", "case_ids": ["FX-C04", "FX-C06"], "author": "FX-EXT-SCHEME", "clocks": {"event_at": "2026-08-20T16:45:00+10:00", "available_at": "2026-08-21T09:00:00+10:00"}, "content": {"mode": "email", "body_text": "Dear Example Super,\n\nPlease find attached the case fee invoice for matter FX-AFCA-01 (complainant Daniel Okafor). Payment is due within 30 days.\n\nCase correspondence team"}, "recipients": ["FX-STAFF-CM02"], "subject": "Matter FX-AFCA-01 - case fee invoice", "afca_matter_ids": ["FX-AFCA-01"], "member_references": ["FX-M04"], "attachments": [{"source_id": "FX-SRC-0403", "disposition": "supplied"}], "reports_events": ["FX-FIN-0401"]}
