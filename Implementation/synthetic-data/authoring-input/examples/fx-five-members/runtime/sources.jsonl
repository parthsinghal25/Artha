{"source_id": "FX-SRC-0306", "kind": "email", "semantic_type": "complaint_followup", "source_family": "S03", "format": "EML", "filename": "2026-06-03_0912_grace-whitfield_again.eml", "case_ids": ["FX-C03"], "author": "FX-P03", "clocks": {"event_at": "2026-06-03T09:12:00+10:00", "available_at": "2026-06-03T09:30:00+10:00"}, "content": {"mode": "email", "body_text": "Lucy,\n\nI can't believe this. A letter dated 28 May asks me AGAIN for a certified copy of my ID - the same one you agreed in March had been accepted in December. Please reopen my complaint.\n\nGrace"}, "recipients": ["FX-STAFF-CM02"], "subject": "RE: Asked again for documents I already sent", "member_references": ["FX-M03"], "reports_events": ["FX-EV-0306"]}
