{"source_id": "FX-SRC-0401", "kind": "call_summary", "semantic_type": "vendor_call_summary", "source_family": "S02", "format": "TXT", "filename": "2026-04-14_call-summary_okafor.txt", "case_ids": ["FX-C04"], "author": "FX-VENDOR-CC", "clocks": {"event_at": "2026-04-14T11:30:00+10:00", "created_at": "2026-04-14T12:05:00+10:00", "available_at": "2026-04-14T12:10:00+10:00"}, "content": {"mode": "text", "text": "CALL SUMMARY (vendor generated)\nCaller: Daniel Okafor (member)\nReason: TPD claim - no decision after 5 months\n\n- Member says insurer asked for the same specialist report twice.\n- Member wants to lodge a formal complaint. Complaint registered.\n- Agent did not give a decision date.\n"}, "member_references": ["FX-M04"]}
{"source_id": "FX-SRC-0402", "kind": "email", "semantic_type": "complaint", "source_family": "S03", "format": "EML", "filename": "2026-07-02_0855_daniel-okafor_complaint.eml", "case_ids": ["FX-C06"], "author": "FX-P04", "clocks": {"event_at": "2026-07-02T08:55:00+10:00", "available_at": "2026-07-02T09:10:00+10:00"}, "content": {"mode": "email", "body_text": "Lucy,\n\nYou closed my complaint on 30 June but nothing has changed - still no decision on my TPD claim. I want this looked at again and I am going to the external scheme if I don't hear back. The medical report from Dr Ellis is the one they keep asking for; I could not attach it from my phone.\n\nDaniel Okafor"}, "recipients": ["FX-STAFF-CM02"], "subject": "TPD claim - still waiting", "member_references": ["FX-M04"], "attachments": [{"filename": "ellis-specialist-report.pdf", "disposition": "not_held"}], "reports_events": ["FX-EV-0403", "FX-EV-0404"]}
